# ---------------------------------------------------------------------------
# The Community Project — environment variables
#
# LOCAL:      run `npm run setup:local`. It writes .env.local for you.
# PRODUCTION: add these in Vercel → Project → Settings → Environment Variables.
#
# NEVER commit real values. This file contains placeholders only.
# [public] = sent to the browser (safe to expose)
# [secret] = server only (never expose, never commit)
# ---------------------------------------------------------------------------

# [public] The full URL of your site, without a trailing slash.
# e.g. https://my-community.vercel.app or https://community.example.org
NEXT_PUBLIC_SITE_URL=<https://your-site-url>

# [public] Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=<https://your-project-ref.supabase.co>

# [public] Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>

# [secret] Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…)
SUPABASE_SECRET_KEY=<your-secret-key>

# [secret] Comma-separated emails that automatically become admins when they log in.
ADMIN_EMAILS=<you@example.org>

# [secret] SMTP credentials for app emails (notifications). Use the same values you
# entered in Supabase → Authentication → Emails → SMTP Settings.
SMTP_HOST=<smtp.resend.com>
SMTP_PORT=<465>
SMTP_USER=<resend>
SMTP_PASS=<your-smtp-password>
# The sender shown to members, e.g. "My Community <hello@community.example.org>"
SMTP_FROM=<My Community <hello@your-domain>>

# [secret] A long random string. Vercel uses it to authenticate the daily cron job.
# Generate one with: openssl rand -hex 32
CRON_SECRET=<a-long-random-string>
